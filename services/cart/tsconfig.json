{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["esnext"],
		"allowJs": true,
		"skipDefaultLibCheck": true,
		"skipLibCheck": true,
		"incremental": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"forceConsistentCasingInFileNames": true,
		"removeComments": true,
		"paths": {
			"@/config/*": ["./config/*"],
			"@/controllers/*": ["./controllers/*"],
			"@/data/*": ["./data/*"],
			"@/generated/*": ["./generated/*"],
			"@/services/*": ["./services/*"],
			"@/types/*": ["./types/*"],
			"@/utils/*": ["./utils/*"],
			"@/routes/*": ["./routes/*"]
		}
	},
	"include": ["./**/*", "prisma/**/*"],
	"exclude": ["node_modules"]
}
