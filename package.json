{
	"name": "ecommerce",
	"version": "0.0.1",
	"private": true,
	"description": "A fake Ecommerce web app using microservice architecture.",
	"license": "MIT",
	"author": "Visakan Kirubakaran",
	"scripts": {
		"prepare": "husky",
		"lint:ts": "biome lint",
		"format:ts": "biome check --write",
		"lint:python": "ruff check services/**/*.py",
		"format:python": "ruff check services/**/*.py --fix && ruff format services/**/*.py",
		"lint:java": "cd services/payment && mvn checkstyle:check",
		"format:java": "cd services/payment && mvn google-java-format:format",
		"bruno:product": "cd services/product/.bruno/product-collection && bru run",
		"bruno:order": "cd services/order/.bruno/order-collection && bru run",
		"bruno:user": "cd services/user/.bruno/user-collection && bru run",
		"bruno:rating": "cd services/rating/.bruno/rating-collection && bru run",
		"bruno:payment": "cd services/payment/.bruno/payment-collection && bru run",
		"bruno:cart": "cd services/cart/.bruno/cart-collection && bru run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@semantic-release/git": "^10.0.1",
		"@usebruno/cli": "^2.15.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"semantic-release": "^24.2.9"
	}
}