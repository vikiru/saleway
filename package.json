{
  "name": "saleway",
  "version": "0.0.1",
  "private": true,
  "description": "A fake Ecommerce web app using microservice architecture.",
  "license": "MIT",
  "author": "Visakan Kirubakaran",
  "workspaces": [
    "frontend",
    "services/*"
  ],
  "scripts": {
    "lint": "pnpm lint:oxlint && pnpm lint:python && pnpm lint:java",
    "lint:oxlint": "oxlint",
    "lint:python": "ruff check services/**/*.py",
    "lint:java": "cd services/payment && mvn validate",
    "format": "oxfmt --write && ruff check services/**/*.py --fix && ruff format services/**/*.py && cd services/payment && mvn fmt:format",
    "format:oxfmt": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:python": "ruff check services/**/*.py --fix && ruff format services/**/*.py",
    "format:java": "cd services/payment && mvn fmt:format",
    "typecheck": "pnpm --filter saleway-frontend typecheck && pnpm --filter cart-service typecheck",
    "check": "oxfmt --check && pnpm lint && pnpm typecheck",
    "bruno:product": "cd services/product/.bruno/product-collection && bru run",
    "bruno:order": "cd services/order/.bruno/order-collection && bru run",
    "bruno:user": "cd services/user/.bruno/user-collection && bru run",
    "bruno:rating": "cd services/rating/.bruno/rating-collection && bru run",
    "bruno:payment": "cd services/payment/.bruno/payment-collection && bru run",
    "bruno:cart": "cd services/cart/.bruno/cart-collection && bru run",
    "unused": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@usebruno/cli": "^3.5.3",
    "knip": "^6.32.2",
    "lefthook": "^1.13.6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tailwindcss": "^1.9.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "^24.2.9",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.20.0"
}
